generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id             String       @id @default(uuid())
  name           String
  email          String       @unique
  password_hash  String
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  user_roles     user_roles[]
  audit_logs     audit_logs[]
  exports        exports[]
  sessions       sessions[]
  refresh_tokens refresh_tokens[]
}

model roles {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  user_roles  user_roles[]
  permissions permissions[]
}

model permissions {
  id          String @id @default(uuid())
  role_id     String
  resource    String
  action      String
  role        roles  @relation(fields: [role_id], references: [id])
}

model user_roles {
  user_id String
  role_id String
  user    users @relation(fields: [user_id], references: [id])
  role    roles @relation(fields: [role_id], references: [id])
  @@id([user_id, role_id])
}

model elections {
  id          String       @id @default(uuid())
  name        String
  date        DateTime
  status      String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  researches  researches[]
}

model researches {
  id                    String                  @id @default(uuid())
  election_id           String
  name                  String
  status                String
  start_date            DateTime?
  end_date              DateTime?
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  election              elections               @relation(fields: [election_id], references: [id])
  research_questions    research_questions[]
  research_candidates   research_candidates[]
  responses             responses[]
  interviewer_researches interviewer_researches[]
  form_batches          form_batches[]
}

model research_questions {
  id               String             @id @default(uuid())
  research_id      String
  text             String
  type             String
  order            Int
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  research         researches         @relation(fields: [research_id], references: [id])
  research_options research_options[]
  response_answers response_answers[]
}

model research_options {
  id          String             @id @default(uuid())
  question_id String
  text        String
  order       Int
  question    research_questions @relation(fields: [question_id], references: [id])
}

model candidates {
  id                  String                @id @default(uuid())
  name                String
  party               String?
  number              String?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  candidate_sources   candidate_sources[]
  research_candidates research_candidates[]
}

model candidate_sources {
  id           String     @id @default(uuid())
  candidate_id String
  source_type  String
  source_data  String?
  candidate    candidates @relation(fields: [candidate_id], references: [id])
}

model research_candidates {
  id           String     @id @default(uuid())
  research_id  String
  candidate_id String
  research     researches @relation(fields: [research_id], references: [id])
  candidate    candidates @relation(fields: [candidate_id], references: [id])
}

model responses {
  id               String             @id @default(uuid())
  research_id      String
  interviewer_id   String?
  location_id      String?
  status           String
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  research         researches         @relation(fields: [research_id], references: [id])
  interviewer      interviewers?      @relation(fields: [interviewer_id], references: [id])
  location         locations?         @relation(fields: [location_id], references: [id])
  response_answers response_answers[]
}

model response_answers {
  id          String             @id @default(uuid())
  response_id String
  question_id String
  answer_text String?
  response    responses          @relation(fields: [response_id], references: [id])
  question    research_questions @relation(fields: [question_id], references: [id])
}

model interviewers {
  id                     String                   @id @default(uuid())
  name                   String
  document               String?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  interviewer_researches interviewer_researches[]
  responses              responses[]
}

model interviewer_researches {
  interviewer_id String
  research_id    String
  interviewer    interviewers @relation(fields: [interviewer_id], references: [id])
  research       researches   @relation(fields: [research_id], references: [id])
  @@id([interviewer_id, research_id])
}

model municipalities {
  id        String      @id @default(uuid())
  name      String
  state     String
  locations locations[]
}

model locations {
  id              String         @id @default(uuid())
  municipality_id String
  name            String
  type            String
  municipality    municipalities @relation(fields: [municipality_id], references: [id])
  responses       responses[]
}

model qr_codes {
  id         String   @id @default(uuid())
  data       String
  image_url  String?
  created_at DateTime @default(now())
}

model sessions {
  id            String   @id @default(uuid())
  user_id       String
  session_token String   @unique
  expires_at    DateTime
  user          users    @relation(fields: [user_id], references: [id])
}

model refresh_tokens {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  user       users    @relation(fields: [user_id], references: [id])
}

model api_keys {
  id         String   @id @default(uuid())
  key        String   @unique
  name       String
  created_at DateTime @default(now())
}

model audit_logs {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  resource   String
  details    String?
  created_at DateTime @default(now())
  user       users?   @relation(fields: [user_id], references: [id])
}

model exports {
  id         String   @id @default(uuid())
  user_id    String
  file_url   String
  status     String
  created_at DateTime @default(now())
  user       users    @relation(fields: [user_id], references: [id])
}

model settings {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model form_batches {
  id             String          @id @default(uuid())
  research_id    String
  batch_number   String
  created_at     DateTime        @default(now())
  research       researches      @relation(fields: [research_id], references: [id])
  printed_forms  printed_forms[]
}

model printed_forms {
  id                   String                 @id @default(uuid())
  batch_id             String
  form_code            String                 @unique
  status               String
  batch                form_batches           @relation(fields: [batch_id], references: [id])
  form_processing_logs form_processing_logs[]
}

model form_processing_logs {
  id              String        @id @default(uuid())
  printed_form_id String
  status          String
  log             String?
  created_at      DateTime      @default(now())
  printed_form    printed_forms @relation(fields: [printed_form_id], references: [id])
}
